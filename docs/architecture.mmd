---
config:
  theme: base
  themeVariables:
    primaryColor: "#0f172a"
    primaryTextColor: "#e2e8f0"
    primaryBorderColor: "#0063e5"
    lineColor: "#38bdf8"
    secondaryColor: "#1e293b"
    tertiaryColor: "#1e293b"
    clusterBkg: "#f0f7ff"
    clusterBorder: "#bfdbfe"
    edgeLabelBackground: "#e8f0ff"
    mainBkg: "#0f172a"
    nodeBorder: "#0063e5"
    titleColor: "#1e1b4b"
    fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif"
    fontSize: "13px"
---

flowchart TB
    User([User]) --> HTML["index.html\nInterview + card modal"]
    Reader([Someone with a link]) --> CardPage["card.html\nRead-only shared card"]
    Team([A team]) --> PartyPage["party.html\nParty board"]

    subgraph App["App shell"]
        HTML --> app["app.js\nEntry point"]
        app --> state["state.js\nLive sheet + Convex"]
        state --> sheet["sheet.js\nThe sheet's shape"]
        app --> data["data.js\nSections + RPG classes"]
        app --> render["render.js\nSection rendering"]
        app --> events["events.js\nDelegated routing"]
        events --> builder["builder.js\nAvatar + media picks"]
        events --> present["present.js\nDeck + presenter script"]
    end

    subgraph Card["js/card/ — DOM + CSS, not canvas"]
        panel["panel.js\nThe card modal"] --> model["model.js\nSheet → ranked blocks"]
        panel --> presets["presets.js\n7 themes · 5 layouts, as data"]
        model --> cardrender["render.js\nBlocks → DOM + measured fit"]
        presets --> cardrender
        cardrender --> export["export.js"]
    end

    subgraph Share["js/share/"]
        link["link.js\ngzip + base64url\nanswer stripped at the encoder"]
        qr["qr.js\nQR generated locally"]
    end

    events --> panel
    panel --> link
    panel --> qr

    export -->|"SVG foreignObject → 1× / 2× / 3×"| PNG["PNG"]
    export -->|"@media print"| PDF["Vector PDF\nselectable text"]

    link -.->|"#s= fragment\nnever sent to a server"| CardPage
    CardPage --> reader["reader.js"]
    reader --> model
    reader --> cardrender

    link -.->|"#r= fragment\none gzip window"| PartyPage
    PartyPage --> party["party.js"]
    party --> analyze["party/analyze.js\noverlap · common ground\ncomposition · prompts"]
    party --> sheet
    analyze --> sheet

    app --> api["api.js"]
    api -->|"search"| Worker["Cloudflare Worker\nkeys stay server-side"]
    Worker --> RAWG["RAWG"]
    Worker --> Jikan["Jikan"]
    Worker --> TMDB["TMDB"]

    state -.->|"optional, Clerk-authed"| Convex["Convex\nmulti-sheet storage"]
